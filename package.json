{
  "name": "planejador-senai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check:publish": "node scripts/check-publication.js",
    "start": "node server.js",
    "import": "node scripts/import.js",
    "test": "node --test tests/api.test.mjs tests/calendar-export.test.mjs tests/teacher-calendar-export.test.mjs tests/schedule.test.mjs tests/excel-preview.test.mjs tests/docentes.test.mjs tests/turma-copy.test.mjs tests/search.test.mjs tests/password-reset.test.mjs tests/publication.test.mjs tests/notifications.test.mjs tests/planning.test.mjs tests/management-report.test.mjs tests/diagnostics.test.mjs tests/daily-program.test.mjs tests/education-rules.test.mjs tests/daily-display.test.mjs tests/environment-import.test.mjs tests/key-control.test.mjs",
    "test:ui": "npm run build && node tests/ui.smoke.mjs",
    "test:ui:copy": "npm run build && node tests/turma-copy.ui.mjs",
    "test:ui:search": "npm run build && node tests/search.ui.mjs",
    "test:ui:recovery": "npm run build && node tests/recovery.ui.mjs",
    "test:ui:history": "npm run build && node tests/history.ui.mjs",
    "test:ui:notifications": "npm run build && node tests/notifications.ui.mjs",
    "test:ui:planning": "npm run build && node tests/planning.ui.mjs",
    "test:ui:reports": "npm run build && node tests/management-report.ui.mjs",
    "test:ui:mobile": "npm run build && node tests/mobile.ui.mjs",
    "test:ui:diagnostics": "npm run build && node tests/diagnostics.ui.mjs",
    "test:ui:docentes": "npm run build && node tests/docentes.ui.mjs",
    "test:ui:ambientes": "npm run build && node tests/ambientes.ui.mjs",
    "test:ui:education": "npm run build && node tests/education-rules.ui.mjs",
    "test:ui:environment-import": "npm run build && node tests/environment-import.ui.mjs",
    "test:ui:keys": "npm run build && node tests/key-control.ui.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.64.0"
  }
}
