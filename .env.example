# Senha do coordenador (obrigatória)
ADMIN_PASSWORD=defina-uma-senha-forte
# Texto aleatório longo para assinar a sessão (obrigatório, diferente da senha mestre)
SESSION_SECRET=troque-por-um-texto-aleatorio-longo
# Banco Turso (obrigatório na Vercel/Netlify). Local: deixe em branco para usar data/planejador.db
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# --- Avisos automáticos (opcional; sem estas chaves o envio é só simulado) ---
# E-mail (Resend, resend.com): domínio verificado e chave de API
RESEND_API_KEY=
MAIL_FROM=Calendário SENAI <avisos@seudominio.com.br>
# WhatsApp (API oficial da Meta): token permanente, id do número e nome do modelo aprovado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=aviso_calendario
WHATSAPP_LANG=pt_BR
# Endereço público do site (usado nos links das mensagens)
PUBLIC_URL=https://seu-site.vercel.app
# Senha do agendador (Vercel cron envia automaticamente como Bearer; escolha um texto longo)
CRON_SECRET=

# --- Backup agendado (opcional) ---
# Diariamente às 20h o sistema guarda uma cópia no próprio banco (últimas 30 + a 1ª de cada mês por 12 meses).
# Cópia por e-mail aos domingos (precisa do serviço de e-mail acima). Vários endereços: separe por vírgula.
BACKUP_EMAIL=
# Defina como 1 para NÃO incluir nomes, contatos e faltas de alunos na cópia enviada por e-mail
BACKUP_EMAIL_SEM_ALUNOS=
